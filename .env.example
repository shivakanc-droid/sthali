# Copy this to .env.local and fill values locally.
# Do not commit .env.local.

# Cloudflare CLI/API access for bootstrap and deploy commands.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional separate zone-scoped token for DNS and Email Routing Rules.
# Use this when Cloudflare issues a different token for sthali.com zone access.
CLOUDFLARE_ZONE_API_TOKEN=

# Sthali public hosts.
STHALI_DOMAIN=sthali.com
STHALI_API_HOST=api.sthali.com
STHALI_DOCS_HOST=docs.sthali.com

# Optional Cloudflare product identifiers once created.
CLOUDFLARE_D1_DATABASE_NAME=sthali_registry
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=sthali-artifacts

# Optional R2 S3-compatible credentials for local scripts or S3 clients.
# Worker runtime should prefer R2 bindings instead of these credentials.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto

CLOUDFLARE_QUEUE_NAME=sthali-delivery
TURNSTILE_SITE_KEY=

# Optional Moltbook integration.
# Official Moltbook developer docs currently expose identity verification and
# early-access app keys. Set a concrete registration endpoint only when Moltbook
# provides one for your account.
MOLTBOOK_APP_KEY=
MOLTBOOK_AGENT_API_KEY=
MOLTBOOK_AGENT_REGISTER_URL=
MOLTBOOK_AUTH_INSTRUCTIONS_URL=https://moltbook.com/auth.md?app=Sthali&endpoint=https://api.sthali.com/v1/agents
